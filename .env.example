# Discord
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_ALLOWED_USERS=your_discord_user_id
DISCORD_HOME_CHANNEL=your_main_channel_id

# Steam API — https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key

# GG.deals (primary price source) — https://gg.deals/api/
GG_DEALS_API_KEY=your_gg_deals_api_key

# IsThereAnyDeal (fallback price source) — https://isthereanydeal.com/page/api/
ITAD_API_KEY=your_itad_api_key

# Discord channel IDs (right-click channel → Copy ID)
NEWS_CHANNEL_ID=your_game_news_channel_id
RECAP_CHANNEL_ID=your_recaps_channel_id
PRICE_ALERT_CHANNEL_ID=your_price_alerts_channel_id

# Database path — defaults to watchlist.db in project root if not set
# DB_PATH=/absolute/path/to/watchlist.db
